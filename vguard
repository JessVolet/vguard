menu_interactivo_categorizado() {
    while true; do
        print_banner
        load_config
        echo -e "${CLR_BOLD}$(t MAIN_MENU_TITLE)${CLR_RESET}"
        draw_separator
        echo "$(t CAT_WORKSPACE)"
        echo "$(t CAT_SELECTED)"
        echo "$(t CAT_GLOBAL)"
        echo "$(t CAT_SYSTEM)"
        echo "$(t CAT_EXIT)"
        draw_separator
        read -p "$(t SELECT_OPTION) (1-5): " cat_option

        case "$cat_option" in
            1)
                echo -e "\n${CLR_BOLD}--- WORKSPACE & CONTEXT MANAGEMENT ---${CLR_RESET}"
                echo "1) Select Active Target (vguard select)"
                echo "2) View Active Context Status (vguard context)"
                echo "3) Clear Active Selection (vguard unselect)"
                echo "4) Back to Main Menu"
                read -p "Option (1-4): " sub_opt1
                case "$sub_opt1" in
                    1) seleccionar_contexto ;;
                    2) mostrar_contexto_activo ;;
                    3) limpiar_contexto ;;
                    *) ;;
                esac
                ;;
            2)
                echo -e "\n${CLR_BOLD}--- ACTIVE TARGET OPERATIONS (SELECTED) ---${CLR_RESET}"
                echo "1) Active Target Status (Read-Only)"
                echo "2) Subfolder ASCII Tree (Read-Only)"
                echo "3) Open TUI Interactive Explorer"
                echo "4) Create Nested Subfolder"
                echo "5) Set Custom Subfolder Policy"
                echo "6) Execute Explicit Auto-Heal"
                echo "7) Hot-Resize LVM Volume"
                echo "8) Rename Active Target"
                echo "9) Take LVM Snapshot"
                echo "10) Delete Active Target (Double verification)"
                echo "11) Back to Main Menu"
                read -p "Option (1-11): " sub_opt2
                case "$sub_opt2" in
                    1) mostrar_contexto_activo ;;
                    2) mostrar_arbol_volumen "" ;;
                    3) explorar_volumen_tui "" ;;
                    4) crear_subcarpeta "" ;;
                    5) establecer_politica_subcarpeta "" ;;
                    6) reparar_almacenamiento "" ;;
                    7) redimensionar_volumen "" ;;
                    8) renombrar_almacenamiento "" ;;
                    9) crear_snapshot "" ;;
                    10) remover_almacenamiento "" ;;
                    *) ;;
                esac
                ;;
            3)
                echo -e "\n${CLR_BOLD}--- PROVISIONING & GLOBAL OPERATIONS ---${CLR_RESET}"
                echo "1) Create New Storage Volume"
                echo "2) List All Managed Volumes (Read-Only)"
                echo "3) Inspect Volume Tree (Read-Only)"
                echo "4) Audit Target Drift (Read-Only)"
                echo "5) Execute Auto-Heal on Target"
                echo "6) Execute Auto-Heal on ALL Volumes (Heal-All)"
                echo "7) Back to Main Menu"
                read -p "Option (1-7): " sub_opt3
                case "$sub_opt3" in
                    1) crear_almacenamiento ;;
                    2) listar_volumenes_gestionados ;;
                    3) mostrar_arbol_volumen ;;
                    4) auditar_y_reparar_directorio "" "true" ;;
                    5) reparar_almacenamiento ;;
                    6) sanar_todos_los_volumenes ;;
                    *) ;;
                esac
                ;;
            4)
                echo -e "\n${CLR_BOLD}--- SYSTEM CONFIGURATION & MAINTENANCE ---${CLR_RESET}"
                echo "1) Set Language (en / es)"
                echo "2) Set Explorer Mode (experimental / stable)"
                echo "3) Self-Update VGUARD (git pull)"
                echo "4) Uninstall VGUARD"
                echo "5) Back to Main Menu"
                read -p "Option (1-5): " sub_opt4
                case "$sub_opt4" in
                    1)
                        read -p "Enter language (en/es): " set_lang
                        configurar_idioma "$set_lang"
                        ;;
                    2)
                        read -p "Enter explorer mode (experimental/stable): " set_mode
                        configurar_modo_explorer "$set_mode"
                        ;;
                    3) actualizar_vguard ;;
                    4) bash "$SCRIPT_DIR/uninstall.sh" ;;
                    *) ;;
                esac
                ;;
            5)
                exit 0
                ;;
            *)
                msg_error "$(t INVALID_OPTION)"
                ;;
        esac
    done
}

main() {
    load_config

    local comando="${1:-menu}"

    case "$comando" in
        init)
            init_config
            ;;
        config)
            if [ "$2" = "--lang" ] || [ "$2" = "-l" ]; then
                configurar_idioma "$3"
            elif [ "$2" = "--mode" ] || [ "$2" = "--explorer" ] || [ "$2" = "-m" ]; then
                configurar_modo_explorer "$3"
            else
                msg_info "Config options:"
                msg_info "  vguard config --lang [en|es]"
                msg_info "  vguard config --mode [experimental|stable]"
            fi
            ;;
        use|select)
            seleccionar_contexto "$2" "$3"
            ;;
        unselect|clear)
            limpiar_contexto
            ;;
        context)
            mostrar_contexto_activo
            ;;
        tree)
            mostrar_arbol_volumen "$2" "$3"
            ;;
        explore)
            explorar_volumen_tui "$2"
            ;;
        selected)
            local subaccion="${2:-status}"
            case "$subaccion" in
                --help|-h)
                    mostrar_ayuda_selected
                    ;;
                status|info)
                    mostrar_contexto_activo
                    ;;
                tree)
                    mostrar_arbol_volumen "" "$3"
                    ;;
                explore)
                    explorar_volumen_tui ""
                    ;;
                mkdir|subfolder)
                    crear_subcarpeta "" "$3"
                    ;;
                set-policy)
                    shift 2
                    establecer_politica_subcarpeta "" "$@"
                    ;;
                set-profile|profile)
                    asignar_perfil_servicio "" "$3"
                    ;;
                save-policy|learn)
                    guardar_politica_desde_disco "" "$3"
                    ;;
                resize|extend)
                    redimensionar_volumen "" "$3"
                    ;;
                rename)
                    renombrar_almacenamiento "" "$3"
                    ;;
                heal|repair)
                    reparar_almacenamiento ""
                    ;;
                audit)
                    if cargar_contexto >/dev/null 2>&1; then
                        auditar_y_reparar_directorio "$CTX_MOUNT_POINT" "true"
                    else
                        msg_error "No target selected. Use 'vguard select <volume>' first."
                    fi
                    ;;
                snap)
                    crear_snapshot "" "$3"
                    ;;
                logs)
                    auditar_logs_selinux ""
                    ;;
                delete|remove|rm)
                    remover_almacenamiento ""
                    ;;
                *)
                    msg_error "Subcommand '$subaccion' for 'selected' not recognized."
                    mostrar_ayuda_selected
                    exit 1
                    ;;
            esac
            ;;
        create)
            crear_almacenamiento "$2" "$3" "$4"
            ;;
        heal|repair)
            reparar_almacenamiento "$2"
            ;;
        heal-all)
            sanar_todos_los_volumenes
            ;;
        audit)
            if [ -n "$2" ]; then
                auditar_y_reparar_directorio "$2" "true"
            elif cargar_contexto >/dev/null 2>&1; then
                auditar_y_reparar_directorio "$CTX_MOUNT_POINT" "true"
            else
                msg_error "Specify a target path or select an active volume with 'vguard select <volume>'."
                exit 1
            fi
            ;;
        status|list|ls)
            listar_volumenes_gestionados
            ;;
        manage|edit)
            gestionar_almacenamiento
            ;;
        rename)
            renombrar_almacenamiento "$2" "$3"
            ;;
        resize|extend)
            redimensionar_volumen "$2" "$3"
            ;;
        mkdir|subfolder)
            crear_subcarpeta "$2" "$3"
            ;;
        set-policy)
            shift 1
            establecer_politica_subcarpeta "$@"
            ;;
        set-profile|profile)
            asignar_perfil_servicio "$2" "$3"
            ;;
        save-policy|learn)
            guardar_politica_desde_disco "$2" "$3"
            ;;
        logs)
            auditar_logs_selinux "$2"
            ;;
        remove|rm|delete)
            remover_almacenamiento "$2"
            ;;
        snap)
            crear_snapshot "$2" "$3"
            ;;
        snap-list|snaps)
            listar_snapshots
            ;;
        rollback)
            revertir_snapshot "$2"
            ;;
        update|self-update)
            actualizar_vguard
            ;;
        uninstall)
            if [ -f "$SCRIPT_DIR/uninstall.sh" ]; then
                bash "$SCRIPT_DIR/uninstall.sh"
            else
                msg_error "uninstall.sh script not found"
                exit 1
            fi
            ;;
        help|--help|-h)
            mostrar_ayuda_principal
            ;;
        menu)
            menu_interactivo_categorizado
            ;;
        *)
            msg_error "Unknown command '$comando'."
            mostrar_ayuda_principal
            exit 1
            ;;
    esac
}

main "$@"
